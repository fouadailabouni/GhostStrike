# Python
__pycache__/
*.pyc
*.pyo

# GhostStrike runtime-generated output (not source code) --
# per-run scan results, evidence, findings, sessions, backups, reports.
# Matches the "<module_name>_<YYYYMMDD>_<HHMMSS>/" convention every module
# uses for its own output directory, wherever it's created.
*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]/
backups/
bash_scripts_for_pentest/evidence/
bash_scripts_for_pentest/findings/
bash_scripts_for_pentest/sessions/
bash_scripts_for_pentest/metrics/repro_sessions/
bash_scripts_for_pentest/metrics/attack_graph/
bash_scripts_for_pentest/benchmarks/results/
bash_scripts_for_pentest/test_results/
bash_scripts_for_pentest/runs/
research/results/
bash_scripts_for_pentest/00-Framework-Core/ci_config/
bash_scripts_for_pentest/00-Framework-Core/ci_reports/

# Engagement runtime state (not source) -- accumulates real engagement
# records as the tool is used.
CyberToolkit/engagements.json

# Local lab data (docker volumes, not source)
bash_scripts_for_pentest/19-Lab-Environment/pentest_lab/volumes/

# Secrets / local environment config -- never commit a real .env, only
# .env.example templates. GS_VAULT_KEY, LLM API keys, and lab-stack
# passwords all belong in the local .env or lib/vault.sh, not in git.
.env
!.env.example
!*/.env.example
credentials/
*.pem
*.key
!*.example.key

# Test/CI output (test-output, not source)
tests/*_results.tsv
tests/*_results.json
test-output/
logs/
runtime/

# Release build output (tools/make_release.sh) -- built artifacts, not source
dist/

# Editor/OS cruft
.DS_Store
Thumbs.db